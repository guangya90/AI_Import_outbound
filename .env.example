# 通用导入 - 环境变量样例
# 复制本文件为 .env.local 并填入真实值 (.env.local 已在 .gitignore 中,不会提交)

# Neon Postgres 数据库连接 (必填)
# 格式: postgresql://user:password@host/db?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# 大模型 - DeepSeek (也可换 OpenAI/Claude/Azure)
# 申请: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
